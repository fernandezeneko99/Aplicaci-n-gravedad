<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.eneko.gravedad" ExtensionBundleVersion="1.3.0" ExtensionBundleName="Gravedad" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.eneko.gravedad.panel" Version="1.3.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[22.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.eneko.gravedad.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host/gravedad.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Gravedad</Menu>
          <Geometry>
            <Size><Width>380</Width><Height>640</Height></Size>
            <MinSize><Width>260</Width><Height>360</Height></MinSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./assets/icon48.png</Icon>
            <Icon Type="RollOver">./assets/icon48.png</Icon>
            <Icon Type="DarkNormal">./assets/icon48.png</Icon>
            <Icon Type="DarkRollOver">./assets/icon48.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
